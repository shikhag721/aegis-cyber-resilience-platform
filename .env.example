# Copy to .env for local development. All values below are placeholders -
# never commit real secrets. See SECURITY.md for secret-handling policy.

# --- Database ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=aegis
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aegis:change-me-local-dev-only@db:5432/aegis

# --- Auth ---
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-generated-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- App ---
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_V1_PREFIX=/api/v1

# --- Optional: LLM API for RAG/AI-assistant modules (free/local mode used if unset) ---
ANTHROPIC_API_KEY=
